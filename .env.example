# Copy to .env and adjust. Never commit real credentials.

# Application database (must use the asyncpg driver)
DATABASE_URL=postgresql+asyncpg://drone:drone@localhost:5432/drone
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Flight-permission compliance (only the mock provider exists). A typical sortie is
# estimated at ~22 minutes and the start gate refuses a permission that ends before the
# mission would, so keep the validity comfortably above your longest sortie.
COMPLIANCE_PROVIDER=mock
PERMISSION_VALIDITY_MINUTES=60

# How commands reach drones: "in_memory" (a stand-in for development and tests) or "mqtt".
DRONE_LINK=in_memory

# The MQTT broker (plain mqtt:// only: no authentication or TLS has been requested).
MQTT_URL=mqtt://localhost:1883
# How long to wait for a drone to acknowledge a command before it counts as unanswered.
MQTT_ACK_TIMEOUT_SECONDS=10
# The telemetry worker's durable identity. Run exactly one worker per broker.
MQTT_WORKER_CLIENT_ID=telemetry-worker

# Live tracking (optional). Redis holds the latest drone state and alerts: a view, never the
# source of truth. Leave empty to run without it: nothing else changes.
REDIS_URL=redis://localhost:6379/0
# A drone's latest sample is forgotten this long after its last one.
LIVE_STATE_TTL_SECONDS=60
# Watchdog (alerts only; nothing is ever commanded because of an alert).
LINK_LOST_AFTER_SECONDS=15
LOW_BATTERY_PERCENT=20
STATE_MISMATCH_GRACE_SECONDS=30
WATCHDOG_INTERVAL_SECONDS=5
# The stored battery follows the drone's in steps this big (drone selection reads it).
BATTERY_SYNC_STEP_PERCENT=5
# Reaper: a flight a dispatch left unfinished this long is cancelled and its drone freed.
STALE_RESERVATION_MINUTES=5
REAPER_INTERVAL_SECONDS=60

# Integration tests: an admin connection used to create and drop throwaway databases.
# The role needs CREATEDB and permission to CREATE EXTENSION postgis (a superuser in dev).
TEST_DATABASE_ADMIN_URL=postgresql://drone:drone@localhost:5432/postgres
# Set to 1 to turn "infrastructure unavailable" skips into failures (use in CI).
REQUIRE_INTEGRATION=0

# Webhooks (optional): telling partners about order status changes. Run the sender with
# `python -m app.webhooks` (it refuses to start with no endpoints). One line of JSON, keyed by
# client id; a partner with no entry is simply not told. "secret" is optional: with one, every
# request is signed (X-Timestamp, X-Signature: sha256=HMAC-SHA256(secret, "<timestamp>.<body>")).
# WEBHOOK_ENDPOINTS={"mock": {"url": "https://partner.example/hooks/orders", "secret": "change-me"}}
# One request, from connecting to the status line, may take this long.
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_CONNECT_TIMEOUT_SECONDS=3
# Attempts in one round, and the waits between them: 5 s, then x3 each time, up to an hour,
# with +/-20% jitter. The defaults give up after about an hour and a half.
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE_SECONDS=5
WEBHOOK_BACKOFF_FACTOR=3
WEBHOOK_BACKOFF_CAP_SECONDS=3600
WEBHOOK_BACKOFF_JITTER=0.2
# How long a sender owns a delivery it claimed (must be longer than the timeout), how often an
# idle sender looks for work, how many it claims at once, and how many it sends at once.
WEBHOOK_LEASE_SECONDS=60
WEBHOOK_POLL_SECONDS=1
WEBHOOK_BATCH_SIZE=20
WEBHOOK_CONCURRENCY=10
